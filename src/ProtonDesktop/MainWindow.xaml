<Window x:Class="ProtonDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProtonDesktop"
        xmlns:vm="clr-namespace:ProtonDesktop.ViewModels"
        xmlns:conv="clr-namespace:ProtonDesktop.Converters"
        xmlns:views="clr-namespace:ProtonDesktop.Views"
        mc:Ignorable="d"
        Title="{Binding Title}" 
        Height="700" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:BoolToFontWeightConverter x:Key="BoolToFontWeight"/>
        <conv:DateTimeToStringConverter x:Key="DateTimeToString"/>
        <conv:SizeToStringConverter x:Key="SizeToString"/>
        <conv:UnreadCountToVisibilityConverter x:Key="UnreadCountToVisibility"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E1E1E1" BorderThickness="0,0,0,1" Padding="10,5">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="New Email" Command="{Binding NewEmailCommand}" Padding="15,5" Margin="0,0,5,0" Background="#0078D4" Foreground="White" BorderThickness="0"/>
                    <Button Content="Sync" Command="{Binding SyncCommand}" Padding="15,5" Margin="0,0,5,0"/>
                    <Button Content="Delete" Command="{Binding DeleteCommand}" Padding="15,5" Margin="0,0,5,0"/>
                    <Button Content="Reply" Command="{Binding ReplyCommand}" Padding="15,5" Margin="0,0,5,0"/>
                    <Button Content="Forward" Command="{Binding ForwardCommand}" Padding="15,5"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SyncStatus}" Margin="0,0,10,0" Foreground="#666666"/>
                    <ProgressBar Width="100" Height="4" IsIndeterminate="{Binding IsSyncing}" Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="350" MinWidth="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Folder Tree -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E1E1E1" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Folders" FontWeight="Bold" Padding="10,10,10,5" Foreground="#333333"/>

                    <TreeView Grid.Row="1" 
                              ItemsSource="{Binding FolderTree.Folders}"
                              SelectedItemChanged="FolderTree_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding SubFolders}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <Border Background="#0078D4" 
                                            CornerRadius="8" 
                                            Padding="6,2" 
                                            Margin="5,0,0,0"
                                            Visibility="{Binding UnreadCount, Converter={StaticResource UnreadCountToVisibility}}">
                                        <TextBlock Text="{Binding UnreadCount}" 
                                                   Foreground="White" 
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Email List -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E1E1E1" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Grid Grid.Row="0" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" 
                                 Text="{Binding EmailList.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="5"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" 
                                Content="Search" 
                                Command="{Binding EmailList.SearchCommand}"
                                Padding="10,5"
                                Margin="5,0,0,0"/>
                    </Grid>

                    <!-- Sort Options -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
                        <Button Content="Date" Command="{Binding EmailList.ToggleSortCommand}" CommandParameter="Date" Padding="10,3" Margin="0,0,5,0"/>
                        <Button Content="From" Command="{Binding EmailList.ToggleSortCommand}" CommandParameter="From" Padding="10,3" Margin="0,0,5,0"/>
                        <Button Content="Subject" Command="{Binding EmailList.ToggleSortCommand}" CommandParameter="Subject" Padding="10,3" Margin="0,0,5,0"/>
                        <Button Content="Size" Command="{Binding EmailList.ToggleSortCommand}" CommandParameter="Size" Padding="10,3"/>
                    </StackPanel>

                    <!-- Message List -->
                    <ListView Grid.Row="2" 
                              ItemsSource="{Binding EmailList.Messages}"
                              SelectedItem="{Binding EmailList.SelectedMessage}"
                              SelectionChanged="EmailList_SelectionChanged"
                              BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" BorderBrush="#E1E1E1" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- From and Date -->
                                        <DockPanel Grid.Row="0">
                                            <TextBlock Text="{Binding ReceivedAtDisplay}" 
                                                       DockPanel.Dock="Right"
                                                       Foreground="#666666"
                                                       FontSize="11"/>
                                            <TextBlock Text="{Binding FromName}" 
                                                       FontWeight="{Binding IsRead, Converter={StaticResource BoolToFontWeight}}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>

                                        <!-- Subject -->
                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding Subject}"
                                                   FontWeight="{Binding IsRead, Converter={StaticResource BoolToFontWeight}}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>

                                        <!-- Preview and Attachments -->
                                        <DockPanel Grid.Row="2">
                                            <TextBlock Text="📎" 
                                                       DockPanel.Dock="Left"
                                                       Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}"
                                                       Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Preview}" 
                                                       Foreground="#666666"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Loading Indicator -->
                    <ProgressBar Grid.Row="2" 
                                 IsIndeterminate="True" 
                                 Height="3"
                                 VerticalAlignment="Top"
                                 Visibility="{Binding EmailList.IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Reading Pane -->
            <Border Grid.Column="4" Background="White" BorderBrush="#E1E1E1" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <!-- Empty State -->
                    <TextBlock Text="Select an email to read" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Foreground="#999999"
                               FontSize="14"
                               Visibility="{Binding ReadingPane.IsEmpty, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Message Content -->
                    <ScrollViewer Visibility="{Binding ReadingPane.IsEmpty, Converter={StaticResource InverseBoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15">
                            <!-- Subject -->
                            <TextBlock Text="{Binding ReadingPane.Subject}" 
                                       FontSize="18" 
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <!-- From/To/Date Info -->
                            <Border Background="#F8F8F8" Padding="10" Margin="0,0,0,15" CornerRadius="4">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock Text="From:" FontWeight="SemiBold" Width="60"/>
                                        <TextBlock Text="{Binding ReadingPane.FromName}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock Text="To:" FontWeight="SemiBold" Width="60"/>
                                        <TextBlock Text="{Binding ReadingPane.ToAddresses}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,5" 
                                               Visibility="{Binding ReadingPane.CcAddresses, Converter={StaticResource StringNotEmptyToVisibility}}">
                                        <TextBlock Text="Cc:" FontWeight="SemiBold" Width="60"/>
                                        <TextBlock Text="{Binding ReadingPane.CcAddresses}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Date:" FontWeight="SemiBold" Width="60"/>
                                        <TextBlock Text="{Binding ReadingPane.ReceivedAt}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Attachments -->
                            <Border Visibility="{Binding ReadingPane.HasAttachments, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Attachments:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <ItemsControl ItemsSource="{Binding ReadingPane.Attachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ReadingPane.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="5"
                                                        Margin="0,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📎" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding FileName}"/>
                                                        <TextBlock Text="{Binding SizeDisplay}" Foreground="#666666" Margin="10,0,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Body -->
                            <Border BorderBrush="#E1E1E1" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                                <TextBlock Text="{Binding ReadingPane.Body}" 
                                           TextWrapping="Wrap"
                                           FontSize="13"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#F8F8F8" BorderBrush="#E1E1E1" BorderThickness="0,1,0,0" Padding="10,5">
            <DockPanel>
                <TextBlock Text="Ready" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding EmailList.Messages.Count, StringFormat='{}{0} messages'}" 
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
