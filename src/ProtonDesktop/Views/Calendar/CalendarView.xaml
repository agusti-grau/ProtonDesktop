<Window x:Class="ProtonDesktop.Views.Calendar.CalendarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ProtonDesktop.ViewModels.Calendar"
        xmlns:conv="clr-namespace:ProtonDesktop.Converters"
        mc:Ignorable="d"
        Title="Calendar" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E1E1E1" BorderThickness="0,0,0,1" Padding="10,5">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Today" Command="{Binding TodayCommand}" Padding="15,5" Margin="0,0,5,0"/>
                    <Button Content="◀" Command="{Binding PreviousCommand}" Padding="10,5" Margin="0,0,5,0"/>
                    <Button Content="▶" Command="{Binding NextCommand}" Padding="10,5" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding CurrentDate, StringFormat='{}{0:MMMM yyyy}'}" 
                               VerticalAlignment="Center" 
                               FontSize="16" 
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Day" Command="{Binding ChangeViewModeCommand}" CommandParameter="{x:Static vm:CalendarViewMode.Day}" Padding="15,5" Margin="0,0,5,0"/>
                    <Button Content="Week" Command="{Binding ChangeViewModeCommand}" CommandParameter="{x:Static vm:CalendarViewMode.Week}" Padding="15,5" Margin="0,0,5,0"/>
                    <Button Content="Month" Command="{Binding ChangeViewModeCommand}" CommandParameter="{x:Static vm:CalendarViewMode.Month}" Padding="15,5" Margin="0,0,5,0"/>
                    <Button Content="New Event" Padding="15,5" Background="#0078D4" Foreground="White" Click="NewEvent_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Calendar List -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E1E1E1" BorderThickness="0,0,0,1" Padding="10,5">
            <ItemsControl ItemsSource="{Binding Calendars}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" 
                                  IsChecked="{Binding IsVisible}"
                                  Margin="0,0,15,0">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" 
                                                Background="{Binding Color}" 
                                                CornerRadius="2"
                                                Margin="0,0,5,0"/>
                                        <ContentPresenter Content="{TemplateBinding Content}"/>
                                    </StackPanel>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Calendar Content -->
        <Grid Grid.Row="2" Margin="10">
            <!-- Month View -->
            <Border Visibility="{Binding IsMonthView, Converter={StaticResource BooleanToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Day Headers -->
                    <UniformGrid Grid.Row="0" Columns="7" Margin="0,0,0,5">
                        <TextBlock Text="Sun" FontWeight="SemiBold" HorizontalAlignment="Center" Padding="5"/>
                        <TextBlock Text="Mon" FontWeight="SemiBold" HorizontalAlignment="Center" Padding="5"/>
                        <TextBlock Text="Tue" FontWeight="SemiBold" HorizontalAlignment="Center" Padding="5"/>
                        <TextBlock Text="Wed" FontWeight="SemiBold" HorizontalAlignment="Center" Padding="5"/>
                        <TextBlock Text="Thu" FontWeight="SemiBold" HorizontalAlignment="Center" Padding="5"/>
                        <TextBlock Text="Fri" FontWeight="SemiBold" HorizontalAlignment="Center" Padding="5"/>
                        <TextBlock Text="Sat" FontWeight="SemiBold" HorizontalAlignment="Center" Padding="5"/>
                    </UniformGrid>

                    <!-- Calendar Grid -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MonthDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E1E1E1" BorderThickness="1" Margin="1" Padding="5" MinHeight="80">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" 
                                                   Text="{Binding Day}" 
                                                   FontWeight="{Binding IsCurrentMonth, Converter={StaticResource BoolToFontWeight}}"
                                                   HorizontalAlignment="Right"/>

                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Events}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding Color}" 
                                                            CornerRadius="2" 
                                                            Padding="3,2" 
                                                            Margin="0,1">
                                                        <TextBlock Text="{Binding Title}" 
                                                                   Foreground="White" 
                                                                   FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Week View -->
            <Border Visibility="{Binding IsWeekView, Converter={StaticResource BooleanToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Time Labels -->
                        <ItemsControl Grid.Column="0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Height="60" VerticalAlignment="Top" Padding="5"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Week Grid -->
                        <UniformGrid Grid.Column="1" Columns="7">
                            <!-- Week days will be populated dynamically -->
                        </UniformGrid>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Day View -->
            <Border Visibility="{Binding IsDayView, Converter={StaticResource BooleanToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Time Labels -->
                        <ItemsControl Grid.Column="0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Height="60" VerticalAlignment="Top" Padding="5"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Day Events -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Color}" 
                                            CornerRadius="4" 
                                            Padding="10" 
                                            Margin="5"
                                            MinHeight="60">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="{Binding DateTimeRange}" Foreground="White" FontSize="11"/>
                                            <TextBlock Text="{Binding Location}" Foreground="White" FontSize="11" 
                                                       Visibility="{Binding Location, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
