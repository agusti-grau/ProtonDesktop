<Window x:Class="ProtonDesktop.Views.Calendar.EventEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Event Editor" 
        Height="500" 
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Title:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,15"/>

        <!-- Calendar -->
        <TextBlock Grid.Row="2" Text="Calendar:" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="3" ItemsSource="{Binding Calendars}" 
                  SelectedItem="{Binding SelectedCalendar}"
                  DisplayMemberPath="Name"
                  Padding="5" Margin="0,0,0,15"/>

        <!-- Location -->
        <TextBlock Grid.Row="4" Text="Location:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="5" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,15"/>

        <!-- Date/Time -->
        <Grid Grid.Row="6" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Start:" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker Grid.Column="0" SelectedDate="{Binding StartDate}" Padding="5"/>
                    <TextBox Grid.Column="2" Text="{Binding StartTime, StringFormat='{}{0:hh\\:mm}'}" 
                             Padding="5" Width="60" IsEnabled="{Binding IsAllDay, Converter={StaticResource InverseBoolConverter}}"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="End:" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker Grid.Column="0" SelectedDate="{Binding EndDate}" Padding="5"/>
                    <TextBox Grid.Column="2" Text="{Binding EndTime, StringFormat='{}{0:hh\\:mm}'}" 
                             Padding="5" Width="60" IsEnabled="{Binding IsAllDay, Converter={StaticResource InverseBoolConverter}}"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- All Day -->
        <CheckBox Grid.Row="7" Content="All day event" IsChecked="{Binding IsAllDay}" VerticalAlignment="Top" Margin="0,0,0,15"/>

        <!-- Description -->
        <TextBlock Grid.Row="7" Text="Description:" Margin="0,30,0,5" VerticalAlignment="Top"/>
        <TextBox Grid.Row="7" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                 TextWrapping="Wrap" AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto"
                 Padding="5" Margin="0,50,0,0"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Delete" Command="{Binding DeleteCommand}" Padding="15,5" Margin="0,0,5,0"
                    Visibility="{Binding EditingEventId, Converter={StaticResource NullToVisibilityConverter}}"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="15,5" Margin="0,0,5,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Padding="15,5" Background="#0078D4" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
